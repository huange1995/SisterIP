# 复制本文件为 scripts/.env 并填入你的密钥（火山方舟控制台 → API Key 管理）
# 本技能自包含：装到哪个工作区就在哪个工作区出图/出视频。

# 必填：火山方舟 API Key
ARK_API_KEY=your_ark_api_key_here

# 可选覆盖（不设则用脚本内置默认值，一般不用动）：
# 开通的是别的模型时改这里，如：ARK_MODEL=doubao-seedream-5-0-260128
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# ARK_MODEL=doubao-seedream-5-0-lite-260128

# 视频（Seedance 图生视频，需在控制台开通对应视频模型）：
# ARK_VIDEO_MODEL=doubao-seedance-2-0-260128      # 未开通 2.0 可回退 doubao-seedance-1-0-lite-i2v-250428
# ARK_VIDEO_RATIO=9:16
# ARK_VIDEO_RESOLUTION=720p
# ARK_FIRSTFRAME_MODE=derive                       # derive=Seedream 竖版衍生(需 --ff-prompt) | crop=中心裁剪

# 产物根目录（默认 <工作区>/qianmian-yujie-render，可重定向到任意目录）
# QYJ_OUTPUT_DIR=D:/xxx/qianmian-yujie-render

# 人不变校验（默认 cpu；已配好 CUDA 可改 auto；模型默认自动下载到 ~/.insightface）
# INSIGHTFACE_PROVIDER=cpu
# INSIGHTFACE_ROOT=   # 有模型时指向含 models/buffalo_l/ 的目录（布局 {root}/models/{name}/）
